{
  "name": "cursor-goal-guardian-extension",
  "displayName": "Cursor Goal Guardian",
  "description": "Your AI agent forgets what it's building. Guardian doesn't: ask like you always do and the request becomes a tracked goal — drift gets caught, false alarms clear themselves, and \"where were we?\" is one glance. Never blocks, never nags.",
  "version": "1.0.0",
  "publisher": "khalidsaidi",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalidsaidi/cursor-goal-guardian.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Chat", "Visualization"],
  "keywords": [
    "cursor",
    "ai-agent",
    "drift",
    "goals",
    "flight-recorder",
    "observability",
    "mcp",
    "hooks",
    "productivity",
    "guardrail"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goalGuardian",
          "title": "Goal Guardian",
          "icon": "media/guardian.svg"
        }
      ]
    },
    "views": {
      "goalGuardian": [
        {
          "type": "webview",
          "id": "goalGuardian.goalPanel",
          "name": "Session"
        }
      ]
    },
    "commands": [
      { "command": "goalGuardian.setup", "title": "Goal Guardian: Set Up Workspace" },
      { "command": "goalGuardian.commandCenter", "title": "Goal Guardian: Command Center" },
      { "command": "goalGuardian.showPanel", "title": "Goal Guardian: Show Panel" },
      { "command": "goalGuardian.refresh", "title": "Goal Guardian: Refresh", "icon": "$(refresh)" },
      { "command": "goalGuardian.openContract", "title": "Goal Guardian: Open Contract" },
      { "command": "goalGuardian.openConfig", "title": "Goal Guardian: Open Config" },
      { "command": "goalGuardian.openState", "title": "Goal Guardian: Open State Store" },
      { "command": "goalGuardian.openActions", "title": "Goal Guardian: Open Action Log" },
      { "command": "goalGuardian.openAuditLog", "title": "Goal Guardian: Open Audit Log" },
      { "command": "goalGuardian.startNextTask", "title": "Goal Guardian: Start Next Task" },
      { "command": "goalGuardian.completeActiveTask", "title": "Goal Guardian: Complete Active Task" },
      { "command": "goalGuardian.rebuildState", "title": "Goal Guardian: Rebuild State from Action Log" },
      { "command": "goalGuardian.dispatchAction", "title": "Goal Guardian: Dispatch Action (Advanced)" },
      { "command": "goalGuardian.rescoreDrift", "title": "Goal Guardian: Review Recent Drift with AI" },
      { "command": "goalGuardian.uninstall", "title": "Goal Guardian: Remove from Workspace" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "goalGuardian.refresh",
          "when": "view == goalGuardian.goalPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Goal Guardian",
      "properties": {
        "goalGuardian.autoStartNextTask": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the next todo task when you save a file and no task is active."
        },
        "goalGuardian.autoPinEditedFiles": {
          "type": "boolean",
          "default": false,
          "description": "Automatically pin files you save to the active task's context."
        },
        "goalGuardian.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Goal Guardian status bar item (only appears once the workspace is set up)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "test": "vitest run",
    "package": "pnpm dlx @vscode/vsce package --no-dependencies --out cursor-goal-guardian.vsix"
  },
  "dependencies": {
    "@goal-guardian/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "cursor-goal-guardian-testkit": "workspace:*",
    "esbuild": "^0.25.9"
  }
}
