{
  "name": "cursor-goal-guardian-extension",
  "displayName": "Cursor Goal Guardian",
  "description": "Help Cursor finish what you asked. Goal loop with OpenAI Codex + DeepSeek, independent review with CGG + Google ADK, and feedback-driven reviewer learning with Google RRSI.",
  "version": "1.0.5",
  "publisher": "khalidsaidi",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalidsaidi/cursor-goal-guardian.git"
  },
  "homepage": "https://github.com/khalidsaidi/cursor-goal-guardian#readme",
  "bugs": {
    "url": "https://github.com/khalidsaidi/cursor-goal-guardian/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Visualization"
  ],
  "keywords": [
    "cursor",
    "goals",
    "goal-loop",
    "independent-review",
    "feedback",
    "productivity",
    "mcp",
    "hooks"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goalGuardian",
          "title": "Goal Guardian",
          "icon": "media/guardian.svg"
        }
      ]
    },
    "views": {
      "goalGuardian": [
        {
          "type": "webview",
          "id": "goalGuardian.goalPanel",
          "name": "Session"
        }
      ]
    },
    "commands": [
      {
        "command": "goalGuardian.setup",
        "title": "Goal Guardian: Set Up Workspace"
      },
      {
        "command": "goalGuardian.commandCenter",
        "title": "Goal Guardian: Command Center"
      },
      {
        "command": "goalGuardian.showPanel",
        "title": "Goal Guardian: Show Panel"
      },
      {
        "command": "goalGuardian.refresh",
        "title": "Goal Guardian: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "goalGuardian.openContract",
        "title": "Goal Guardian: Open Contract"
      },
      {
        "command": "goalGuardian.openConfig",
        "title": "Goal Guardian: Open Config"
      },
      {
        "command": "goalGuardian.openAuditLog",
        "title": "Goal Guardian: Open Audit Log"
      },
      {
        "command": "goalGuardian.uninstall",
        "title": "Goal Guardian: Remove from Workspace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "goalGuardian.refresh",
          "when": "view == goalGuardian.goalPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Goal Guardian",
      "properties": {
        "goalGuardian.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Goal Guardian status bar item (only appears once the workspace is set up)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "test": "vitest run",
    "package": "pnpm dlx @vscode/vsce package --no-dependencies --out cursor-goal-guardian.vsix"
  },
  "dependencies": {
    "@goal-guardian/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "cursor-goal-guardian-testkit": "workspace:*",
    "esbuild": "^0.25.9"
  }
}
