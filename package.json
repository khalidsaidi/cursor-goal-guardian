{
  "name": "cursor-goal-guardian-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:mcp": "pnpm --filter @goal-guardian/mcp dev",
    "dev:hook": "pnpm --filter @goal-guardian/hook dev",
    "package:vsix": "node scripts/package-extension.js",
    "publish:ovsx": "node scripts/publish-extension.js",
    "test:e2e": "pnpm -r build && pnpm --filter @goal-guardian/e2e test:e2e",
    "test:e2e:offline": "pnpm -r build && pnpm --filter @goal-guardian/e2e test:e2e:offline"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.12",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
