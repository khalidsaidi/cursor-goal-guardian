{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "afterFileEdit": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "afterShellExecution": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "postToolUse": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\""
      }
    ],
    "stop": [
      {
        "command": "node \"/ABSOLUTE/PATH/TO/EXTENSION/bin/goal-guardian-hook.cjs\"",
        "loop_limit": 21
      }
    ]
  }
}
